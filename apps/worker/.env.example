# Background worker (VPS). Copy to apps/worker/.env for local development.
# On the VPS, keep the real file OUTSIDE the repository (see docs/deployment-vps.md).
# All values below are safe placeholders - replace them, never commit real values.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://livecontrol:CHANGE_ME_local_postgres_password@localhost:5432/livecontrol
DATABASE_POOL_MAX=5

REDIS_URL=redis://:CHANGE_ME_local_redis_password@localhost:6379

# Health endpoints only. Keep on loopback.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4100

SHUTDOWN_TIMEOUT_MS=15000

# LOCAL VERIFICATION ONLY. Lets a production-mode run (for example `next start`) use the local,
# non-TLS Docker databases. Ignored with an error if any URL points to a non-local host.
# Never set this in Vercel or on the VPS.
# ALLOW_INSECURE_LOCAL=false
