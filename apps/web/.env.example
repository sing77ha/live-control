# Web app (Next.js). Copy to apps/web/.env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables (never in the repo).
# All values below are safe placeholders - replace them, never commit real values.

NODE_ENV=development

# Public base URL of this app. Must be https:// in production.
APP_URL=http://localhost:3000

# Local development value (Docker Compose). In production use a managed Postgres with a
# POOLED connection string and sslmode=require, for example:
#   postgresql://USER:PASSWORD@HOST:6543/DB?sslmode=require
DATABASE_URL=postgresql://livecontrol:CHANGE_ME_local_postgres_password@localhost:5432/livecontrol

# Keep small: every serverless instance opens its own pool.
DATABASE_POOL_MAX=3

# LOCAL VERIFICATION ONLY. Lets a production-mode run (for example `next start`) use the local,
# non-TLS Docker databases. Ignored with an error if any URL points to a non-local host.
# Never set this in Vercel or on the VPS.
# ALLOW_INSECURE_LOCAL=false
