# Root .env - used ONLY by Docker Compose (infra/docker/docker-compose.yml) for local development.
# Copy to .env (git-ignored). Values below are safe placeholders: replace them.
# Use letters and digits only in passwords (they are interpolated into URLs and commands).
# Generate one with:  openssl rand -hex 24

POSTGRES_USER=livecontrol
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
POSTGRES_DB=livecontrol

REDIS_PASSWORD=CHANGE_ME_local_redis_password
